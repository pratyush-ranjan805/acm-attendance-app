# ============================================================
# ACM SIGGRAPH Hackathon Attendance Management System
# Environment Configuration
# ============================================================

# API Base URL for Frontend
NEXT_PUBLIC_API_URL=/api

# ─── Supabase (REQUIRED) ────────────────────────────────────
# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Service Role key (server-side only — never expose in browser)
# Found in: Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anon key (public, safe to expose)
# Found in: Supabase Dashboard > Settings > API > anon
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Admin Authentication ──────────────────────────────────
# Option 1 (Easiest): Shared password for attendance desk volunteers / admins
# Allows login using ADMIN_EMAIL (default: admin@acm.org) OR any profiles.college_email where is_admin = true
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@acm.org

# ─── JWT Secret ─────────────────────────────────────────────
# Used to sign admin session tokens (change in production!)
JWT_SECRET=acm-siggraph-attendance-secret-key-2026-secure-token


# ============================================================
# ACM SIGGRAPH Hackathon Attendance Management System
# Backend Environment Configuration
# ============================================================

# API Base URL for Frontend (use /api for integrated Next.js API or full URL for standalone deployment)
NEXT_PUBLIC_API_URL=/api

# Database Configuration (Defaults to local SQLite file: file:./data/attendance.db)
DATABASE_URL=file:./data/attendance.db
# DATABASE_AUTH_TOKEN= (Optional for remote Turso/LibSQL database)

# JWT Secret for Admin Authentication (Change in production!)
JWT_SECRET=acm-siggraph-attendance-secret-key-2026-secure-token

# Default Admin Credentials (Auto-seeded on first run)
DEFAULT_ADMIN_EMAIL=admin@siggraph.acm.org
DEFAULT_ADMIN_PASSWORD=Admin@123
